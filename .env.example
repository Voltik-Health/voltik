# Copy to .env and fill in. The .env file NEVER goes into Git.
# Generate each password with:  openssl rand -hex 24
# (letters and digits only: they go inside a connection URL)
POSTGRES_PASSWORD=
VOLTIK_MIGRATIONS_PASSWORD=
VOLTIK_API_PASSWORD=
VOLTIK_READONLY_PASSWORD=
# Local port of the database (another Postgres may already use 5432)
VOLTIK_DB_PORT=5432

# --- Go API (backend/README.md) ---------------------------------------------
ENVIRONMENT=local
PORT=8080
# Replace CHANGE_ME with VOLTIK_API_PASSWORD (and 5432 with VOLTIK_DB_PORT if you changed it)
DATABASE_URL=postgres://voltik_api:CHANGE_ME@localhost:5432/voltik?sslmode=disable
# Signs the session tokens. Different in every environment: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# Sign-in providers. One left empty answers 503 provider_unavailable.
GOOGLE_CLIENT_IDS=
MICROSOFT_CLIENT_ID=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Backend integration tests (voltik_test only: they delete every row) ----
# Replace CHANGE_ME with VOLTIK_MIGRATIONS_PASSWORD and VOLTIK_API_PASSWORD
VOLTIK_TEST_DATABASE_URL=postgres://voltik_migrations:CHANGE_ME@localhost:5432/voltik_test?sslmode=disable
VOLTIK_TEST_API_DATABASE_URL=postgres://voltik_api:CHANGE_ME@localhost:5432/voltik_test?sslmode=disable
