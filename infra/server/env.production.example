# Copy to /opt/voltik/production/.env on the server and fill in.
# Use DIFFERENT passwords from staging. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
VOLTIK_MIGRATIONS_PASSWORD=
VOLTIK_API_PASSWORD=
VOLTIK_READONLY_PASSWORD=
DB_TUNNEL_PORT=5434
# Production web portal only
CORS_ORIGINS=https://app.YOUR-DOMAIN
