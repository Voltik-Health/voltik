# Copy to /opt/voltik/staging/.env on the server and fill in.
# Generate each password with: openssl rand -hex 24
POSTGRES_PASSWORD=
VOLTIK_MIGRATIONS_PASSWORD=
VOLTIK_API_PASSWORD=
VOLTIK_READONLY_PASSWORD=
DB_TUNNEL_PORT=5433
# Local frontends allowed to call the staging API
CORS_ORIGINS=http://localhost:5173
